# ローカル開発用の環境変数ひな形。`cp .env.example .env` で作成し、値を埋めてください。
# .env は .gitignore 済み。実際の値をこのファイルに書かないこと。

POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=helpdesk

SPRING_PROFILES_ACTIVE=local

DATABASE_URL=jdbc:postgresql://db:5432/helpdesk
DATABASE_USERNAME=helpdesk
DATABASE_PASSWORD=change-me

# 生成例: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

SERVER_PORT=8080
